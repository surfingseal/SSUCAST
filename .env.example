HTTP_ADDR=:8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=crawlserver
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-random-token-at-least-24-bytes
WORKERS=2
REQUEST_TIMEOUT=15s
JOB_TIMEOUT=10m
SOURCE_URL=
# Cron timezone is UTC
SOURCE_SCHEDULE=0 */6 * * *
# Local synthetic HTML only. Disable for real crawling.
DEMO_MODE=true
# Compose only; use hex characters to avoid URI escaping requirements
MONGO_PASSWORD=replace-with-random-hex-password

# Docker kernel 7.0.12 compatibility; MongoDB 8 requires a compatible kernel
MONGODB_IMAGE=mongo:7.0

# Optional JSON source list. University (both disabled): configs/sources.university.json
# Local demo: configs/sources.json; Compose: /app/configs/sources.json
CRAWL_SOURCES_FILE=

# SDK-standard Vertex AI / ADC variables
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Application settings: manual, at most one generation; no paid calls at startup
VERTEX_MODEL=gemini-3.5-flash
CLASSIFICATION_PROVIDER=vertexai
CLASSIFICATION_AUTO_ENABLED=false
CLASSIFICATION_BATCH_SIZE=1
CLASSIFICATION_CONCURRENCY=1
CLASSIFICATION_MAX_ITEMS=1
CLASSIFICATION_TIMEOUT_SECONDS=60
CLASSIFICATION_MAX_RETRIES=0
